# Copie para .env e ajuste. Veja docs/backend-architecture.md (seção 7).
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://liberar:liberar@localhost:5434/liberar
TEST_DATABASE_URL=postgresql://liberar:liberar@localhost:5434/liberar_test
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
CORS_ORIGIN=*
LOG_LEVEL=info

# Assistente (sem a chave, o chat usa o motor de regras local)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# E-mail de recuperação de senha (sem SMTP_URL, o código é logado no console)
SMTP_URL=
MAIL_FROM=LiberAr <no-reply@liberar.app>

# Login social (opcional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
