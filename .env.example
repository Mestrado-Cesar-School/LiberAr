# Copie para .env (o Expo lê variáveis EXPO_PUBLIC_* em tempo de build/start).
#
# URL da API do LiberAr (server/). Padrões quando a variável não existe:
#   - web e simulador iOS: http://localhost:4000
#   - emulador Android:    http://10.0.2.2:4000 (localhost do computador visto pelo emulador)
# Em aparelho físico (Expo Go), use o IP da sua máquina na rede local, ex.: http://192.168.0.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Login social (opcional). Sem estes ids, os botões Google/Apple informam que o
# provedor não está configurado neste ambiente.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
